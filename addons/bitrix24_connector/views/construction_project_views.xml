<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_eigr_construction_project_bitrix_form" model="ir.ui.view">
        <field name="name">eigr.construction.project.bitrix.form</field>
        <field name="model">eigr.construction.project</field>
        <field name="inherit_id" ref="eigr_construction_management.view_eigr_construction_project_form"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="bitrix_deal_id" readonly="True" invisible="not bitrix_deal_id"/>
            </field>
            <xpath expr="//group[@string='Información contractual']" position="inside">
                <field name="bitrix_contract_status" readonly="True" invisible="not bitrix_contract_status"/>
            </xpath>
        </field>
    </record>

</odoo>