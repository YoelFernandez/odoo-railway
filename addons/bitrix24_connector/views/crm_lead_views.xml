<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_lead_form_bitrix" model="ir.ui.view">
        <field name="name">crm.lead.form.bitrix</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>

        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Bitrix24" name="bitrix24">
                    <group>
                        <field name="bitrix_deal_id"/>
                        <field name="bitrix_company_id"/>
                    </group>
                    <group>
                        <button name="push_bitrix"
                                type="object"
                                string="Enviar a Bitrix24"
                                class="btn-primary"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
