<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_bitrix_field_mapping_list" model="ir.ui.view">
        <field name="name">bitrix.field.mapping.list</field>
        <field name="model">bitrix.field.mapping</field>

        <field name="arch" type="xml">
            <list string="Mapeo de campos">
                <field name="entity"/>
                <field name="sequence"/>
                <field name="odoo_field"/>
                <field name="bitrix_field"/>
                <field name="field_type"/>
                <field name="is_bitrix_to_odoo"/>
                <field name="is_odoo_to_bitrix"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_bitrix_field_mapping_form" model="ir.ui.view">
        <field name="name">bitrix.field.mapping.form</field>
        <field name="model">bitrix.field.mapping</field>

        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="entity"/>
                        <field name="sequence"/>
                        <field name="odoo_field"/>
                        <field name="bitrix_field"/>
                        <field name="field_type"/>
                        <field name="is_bitrix_to_odoo"/>
                        <field name="is_odoo_to_bitrix"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bitrix_field_mapping" model="ir.actions.act_window">
        <field name="name">Mapeo de campos</field>
        <field name="res_model">bitrix.field.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_bitrix_mapping"
        name="Mapeo de campos"
        parent="menu_bitrix_root"
        action="action_bitrix_field_mapping"
        sequence="20"
    />

</odoo>
