<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Expediente Técnico ============ -->
    <record id="view_eigr_construction_technical_file_list" model="ir.ui.view">
        <field name="name">eigr.construction.technical.file.list</field>
        <field name="model">eigr.construction.technical_file</field>
        <field name="arch" type="xml">
            <list default_order="date desc">
                <field name="code"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="file_type"/>
                <field name="version"/>
                <field name="approval_date"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft','submitted')"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_eigr_construction_technical_file_form" model="ir.ui.view">
        <field name="name">eigr.construction.technical.file.form</field>
        <field name="model">eigr.construction.technical_file</field>
        <field name="arch" type="xml">
            <form string="Expediente Técnico">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,rejected,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nombre del expediente"/></h1>
                        <h2><field name="code" readonly="1"/></h2>
                    </div>
                    <group>
                        <group string="Identificación">
                            <field name="project_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="file_type"/>
                            <field name="version"/>
                            <field name="date"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group string="Aprobación">
                            <field name="approver_id"/>
                            <field name="approval_date"/>
                        </group>
                    </group>
                    <group string="Observaciones">
                        <field name="notes" nolabel="1"/>
                    </group>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============ Metrados ============ -->
    <record id="view_eigr_construction_metrado_list" model="ir.ui.view">
        <field name="name">eigr.construction.metrado.list</field>
        <field name="model">eigr.construction.metrado</field>
        <field name="arch" type="xml">
            <list default_order="code">
                <field name="code"/>
                <field name="description"/>
                <field name="project_id"/>
                <field name="unit_id"/>
                <field name="quantity"/>
                <field name="unit_price" widget="monetary"/>
                <field name="amount" widget="monetary" sum="Parcial"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_eigr_construction_metrado_form" model="ir.ui.view">
        <field name="name">eigr.construction.metrado.form</field>
        <field name="model">eigr.construction.metrado</field>
        <field name="arch" type="xml">
            <form string="Metrado">
                <sheet>
                    <div class="oe_title">
                        <label for="description"/>
                        <h1><field name="description" placeholder="Descripción del metrado"/></h1>
                        <h2><field name="code"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="unit_id"/>
                            <field name="quantity"/>
                            <field name="unit_price" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group>
                            <field name="amount" widget="monetary" readonly="1"/>
                            <field name="date"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Observaciones..."/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ Cronograma ============ -->
    <record id="view_eigr_construction_schedule_list" model="ir.ui.view">
        <field name="name">eigr.construction.schedule.list</field>
        <field name="model">eigr.construction.schedule</field>
        <field name="arch" type="xml">
            <list default_order="start_date">
                <field name="code"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="duration"/>
                <field name="weight_percent"/>
                <field name="planned_percent"/>
                <field name="actual_percent"/>
            </list>
        </field>
    </record>

    <record id="view_eigr_construction_schedule_form" model="ir.ui.view">
        <field name="name">eigr.construction.schedule.form</field>
        <field name="model">eigr.construction.schedule</field>
        <field name="arch" type="xml">
            <form string="Cronograma">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="project_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="duration"/>
                        </group>
                        <group string="Avance">
                            <field name="weight_percent" string="Peso (%)"/>
                            <field name="planned_percent" widget="progressbar"/>
                            <field name="actual_percent" widget="progressbar"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Observaciones..."/>
                </sheet>
            </form>
        </field>
    </record>

