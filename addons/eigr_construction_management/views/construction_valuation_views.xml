<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eigr_construction_valuation_list" model="ir.ui.view">
        <field name="name">eigr.construction.valuation.list</field>
        <field name="model">eigr.construction.valuation</field>
        <field name="arch" type="xml">
            <list string="Valorizaciónes" default_order="cutoff_date desc" decoration-muted="state == 'cancelled'" decoration-success="state == 'approved'">
                <field name="code"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="cutoff_date"/>
                <field name="planned_progress"/>
                <field name="actual_progress"/>
                <field name="schedule_variance" optional="show"/>
                <field name="valuation_period_amount" widget="monetary" sum="Valorizado"/>
                <field name="actual_cost_period" widget="monetary" sum="Costo real" optional="show"/>
                <field name="cpi_percent" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_eigr_construction_valuation_graph" model="ir.ui.view">
        <field name="name">eigr.construction.valuation.graph</field>
        <field name="model">eigr.construction.valuation</field>
        <field name="arch" type="xml">
            <graph string="Curva S - Avance planificado vs real" type="line" sample="1">
                <field name="cutoff_date" interval="month"/>
                <field name="planned_progress" type="measure"/>
                <field name="actual_progress" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_eigr_construction_valuation_form" model="ir.ui.view">
        <field name="name">eigr.construction.valuation.form</field>
        <field name="model">eigr.construction.valuation</field>
        <field name="arch" type="xml">
            <form string="Valorización de obra">
                <header>
                    <button name="action_generate_lines" string="Cargar Partidas" type="object" invisible="state != 'draft'"/>
                    <button name="action_submit" string="Enviar a aprobación" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Aprobar valorización" type="object" class="btn-primary" groups="eigr_construction_management.group_eigr_manager" invisible="state != 'submitted'"/>
                    <button name="action_reset_draft" string="Devolver a borrador" type="object" groups="eigr_construction_management.group_eigr_manager" invisible="state != 'submitted'"/>
                    <button name="action_cancel" string="Cancelar" type="object" groups="eigr_construction_management.group_eigr_manager" invisible="state not in ('draft', 'submitted')" confirm="¿Confirma la cancelación de esta valorización?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Valorización N. 1" readonly="state != 'draft'"/></h1>
                        <h2><field name="code" readonly="state != 'draft'"/></h2>
                    </div>
                    <group>
                        <group string="Período y control">
                            <field name="project_id" readonly="state != 'draft'" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="budget_id" readonly="state != 'draft'"/>
                            <field name="period_start_date" readonly="state != 'draft'"/>
                            <field name="cutoff_date" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="approved_by_id" widget="many2one_avatar_user" invisible="state != 'approved'"/>
                            <field name="approval_date" invisible="state != 'approved'"/>
                        </group>
                        <group string="Indicadores acumulados">
                            <field name="planned_progress"/>
                            <field name="actual_progress"/>
                            <field name="schedule_variance"/>
                            <field name="valuation_period_amount" widget="monetary"/>
                            <field name="planned_cost" widget="monetary"/>
                            <field name="actual_cost" widget="monetary"/>
                            <field name="cpi_percent"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Informe de produccion" name="progress_lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" default_order="budget_line_id">
                                    <field name="budget_line_id"/>
                                    <field name="unit"/>
                                    <field name="budget_quantity"/>
                                    <field name="planned_quantity_period"/>
                                    <field name="executed_quantity_period"/>
                                    <field name="planned_quantity_accumulated" optional="show"/>
                                    <field name="executed_quantity_accumulated" optional="show"/>
                                    <field name="progress_percent" widget="progressbar" optional="show"/>
                                    <field name="actual_cost_period" widget="monetary"/>
                                    <field name="valuation_period_amount" widget="monetary" sum="Valorización"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                                <form string="Avance de partida">
                                    <sheet>
                                        <group>
                                            <group string="Partida Meta">
                                                <field name="budget_line_id"/>
                                                <field name="unit"/>
                                                <field name="budget_quantity"/>
                                                <field name="unit_cost" widget="monetary"/>
                                                <field name="unit_price" widget="monetary"/>
                                                <field name="currency_id" invisible="1"/>
                                            </group>
                                            <group string="Período actual">
                                                <field name="planned_quantity_period"/>
                                                <field name="executed_quantity_period"/>
                                                <field name="actual_cost_period" widget="monetary"/>
                                                <field name="valuation_period_amount" widget="monetary"/>
                                            </group>
                                        </group>
                                        <group string="Acumulados">
                                            <field name="planned_quantity_accumulated"/>
                                            <field name="executed_quantity_accumulated"/>
                                            <field name="planned_value_accumulated" widget="monetary"/>
                                            <field name="executed_value_accumulated" widget="monetary"/>
                                            <field name="planned_cost_accumulated" widget="monetary"/>
                                            <field name="actual_cost_accumulated" widget="monetary"/>
                                            <field name="progress_percent"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Resumen e incidencias">
                            <field name="notes" placeholder="Hechos relevantes, restricciones y acciones del período..." readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_eigr_construction_valuation_search" model="ir.ui.view">
        <field name="name">eigr.construction.valuation.search</field>
        <field name="model">eigr.construction.valuation</field>
        <field name="arch" type="xml">
            <search string="Buscar valorizaciónes">
                <field name="code"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="budget_id"/>
                <filter name="draft" string="Borradores" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Por aprobar" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Aprobadas" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter name="my_projects" string="Mis obras" domain="['|', '|', '|', ('project_id.responsible_id', '=', uid), ('project_id.control_manager_id', '=', uid), ('project_id.planning_engineer_id', '=', uid), ('project_id.resident_id', '=', uid)]"/>
                <group name="group_by">
                    <filter name="group_project" string="Obra" context="{'group_by': 'project_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_cutoff" string="Fecha de corte" context="{'group_by': 'cutoff_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eigr_construction_valuation" model="ir.actions.act_window">
        <field name="name">Valorizaciónes y Avance</field>
        <field name="res_model">eigr.construction.valuation</field>
        <field name="view_mode">list,graph,form</field>
        <field name="search_view_id" ref="view_eigr_construction_valuation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registre el primer informe de avance</p>
            <p>Controle metrados, costos reales, valorizaciónes e indicadores de la Curva S.</p>
        </field>
    </record>
</odoo>
