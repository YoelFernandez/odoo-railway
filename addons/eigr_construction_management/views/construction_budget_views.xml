<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eigr_construction_budget_list" model="ir.ui.view">
        <field name="name">eigr.construction.budget.list</field>
        <field name="model">eigr.construction.budget</field>
        <field name="arch" type="xml">
            <list string="Presupuestos" default_order="date desc" decoration-muted="state == 'cancelled'" decoration-success="state == 'approved'">
                <field name="code"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="version"/>
                <field name="date"/>
                <field name="line_count"/>
                <field name="amount_cost" widget="monetary" sum="Costo total"/>
                <field name="amount_sale" widget="monetary" sum="Venta total"/>
                <field name="margin_amount" widget="monetary" sum="Margen total" optional="show"/>
                <field name="margin_percent" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_eigr_construction_budget_form" model="ir.ui.view">
        <field name="name">eigr.construction.budget.form</field>
        <field name="model">eigr.construction.budget</field>
        <field name="arch" type="xml">
            <form string="Presupuesto de obra">
                <header>
                    <button name="action_approve" string="Aprobar Presupuesto Meta" type="object" class="btn-primary" groups="eigr_construction_management.group_eigr_manager" invisible="state != 'draft'"/>
                    <button name="action_reset_draft" string="Volver a borrador" type="object" groups="eigr_construction_management.group_eigr_manager" invisible="state != 'approved'"/>
                    <button name="action_cancel" string="Cancelar" type="object" groups="eigr_construction_management.group_eigr_manager" invisible="state == 'cancelled'" confirm="¿Confirma la cancelación del presupuesto?"/>
                    <button name="action_restore" string="Restaurar" type="object" groups="eigr_construction_management.group_eigr_manager" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Presupuesto Meta de la obra" readonly="state != 'draft'"/></h1>
                        <h2><field name="code" readonly="state != 'draft'"/></h2>
                    </div>
                    <group>
                        <group string="Identificacion">
                            <field name="project_id" readonly="state != 'draft'" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="version" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Resumen Meta">
                            <field name="amount_cost" widget="monetary"/>
                            <field name="amount_sale" widget="monetary"/>
                            <field name="margin_amount" widget="monetary"/>
                            <field name="margin_percent"/>
                            <field name="approved_by_id" widget="many2one_avatar_user" invisible="state != 'approved'"/>
                            <field name="approval_date" invisible="state != 'approved'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Partidas" name="budget_lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" default_order="sequence, code">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="chapter" optional="show"/>
                                    <field name="unit"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost" widget="monetary"/>
                                    <field name="subtotal_cost" widget="monetary" sum="Costo Meta"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="subtotal_sale" widget="monetary" sum="Venta Meta"/>
                                    <field name="margin_amount" widget="monetary" sum="Margen" optional="show"/>
                                    <field name="weight_percent" optional="show"/>
                                    <field name="control_item" optional="show"/>
                                    <field name="resource_type" optional="hide"/>
                                    <field name="specific_destination" optional="hide"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                                <form string="Partida">
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="code"/>
                                                <field name="name"/>
                                                <field name="chapter"/>
                                                <field name="unit"/>
                                                <field name="quantity"/>
                                            </group>
                                            <group>
                                                <field name="unit_cost" widget="monetary"/>
                                                <field name="unit_price" widget="monetary"/>
                                                <field name="subtotal_cost" widget="monetary"/>
                                                <field name="subtotal_sale" widget="monetary"/>
                                                <field name="currency_id" invisible="1"/>
                                            </group>
                                        </group>
                                        <group string="Control de la partida">
                                            <field name="control_item"/>
                                            <field name="resource_type"/>
                                            <field name="specific_destination"/>
                                            <field name="weight_percent"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Criterios y observaciones">
                            <field name="notes" placeholder="Supuestos, exclusiones y criterios del presupuesto..." readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_eigr_construction_budget_search" model="ir.ui.view">
        <field name="name">eigr.construction.budget.search</field>
        <field name="model">eigr.construction.budget</field>
        <field name="arch" type="xml">
            <search string="Buscar presupuestos">
                <field name="code"/>
                <field name="name"/>
                <field name="project_id"/>
                <filter name="draft" string="Borradores" domain="[('state', '=', 'draft')]"/>
                <filter name="approved" string="Presupuesto Meta" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter name="my_projects" string="Mis obras" domain="['|', '|', '|', ('project_id.responsible_id', '=', uid), ('project_id.control_manager_id', '=', uid), ('project_id.planning_engineer_id', '=', uid), ('project_id.resident_id', '=', uid)]"/>
                <group name="group_by">
                    <filter name="group_project" string="Obra" context="{'group_by': 'project_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Fecha" context="{'group_by': 'date:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eigr_construction_budget" model="ir.actions.act_window">
        <field name="name">Presupuestos</field>
        <field name="res_model">eigr.construction.budget</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_eigr_construction_budget_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree el presupuesto de una obra</p>
            <p>Defina las Partidas de Control, costos, precios y recursos del Presupuesto Meta.</p>
        </field>
    </record>
</odoo>
