<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eigr_construction_project_dashboard" model="ir.ui.view">
        <field name="name">eigr.construction.project.dashboard</field>
        <field name="model">eigr.construction.project</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" sample="1">
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <strong class="fs-4"><field name="name"/></strong>
                                <div class="text-muted"><field name="code"/></div>
                            </div>
                            <field name="state" widget="label_selection"
                                   options="{'classes': {'draft': 'default', 'startup': 'info', 'planning': 'info', 'execution': 'warning', 'closing': 'warning', 'closed': 'success', 'cancelled': 'danger'}}"/>
                        </div>
                        <div class="row g-2 mt-1">
                            <div class="col-6"><small class="text-muted">Avance físico</small><field name="progress_percent" widget="progressbar"/></div>
                            <div class="col-6"><small class="text-muted">Cierre documental</small><field name="closure_progress" widget="progressbar"/></div>
                            <div class="col-6"><small class="text-muted">Costo Meta</small><div><field name="approved_budget_cost" widget="monetary"/></div></div>
                            <div class="col-6"><small class="text-muted">Venta Meta</small><div><field name="approved_budget_sale" widget="monetary"/></div></div>
                        </div>
                        <div class="d-flex gap-3 mt-3 text-muted">
                            <span><i class="fa fa-calculator me-1" title="Presupuestos"/><field name="budget_count"/></span>
                            <span><i class="fa fa-line-chart me-1" title="Valorizaciónes"/><field name="valuation_count"/></span>
                            <span><i class="fa fa-truck me-1" title="Requerimientos"/><field name="requirement_count"/></span>
                        </div>
                        <footer class="mt-2">
                            <field name="responsible_id" widget="many2one_avatar_user"/>
                            <field name="client_id" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_eigr_construction_dashboard" model="ir.actions.act_window">
        <field name="name">Tablero Ejecutivo</field>
        <field name="res_model">eigr.construction.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_eigr_construction_project_dashboard"/>
        <field name="search_view_id" ref="view_eigr_construction_project_search"/>
    </record>
</odoo>
